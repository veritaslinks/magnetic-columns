// One hexagonal cell of variant C, three layers.
// Layers 1 and 3: 12 generators on the hexagon perimeter (regions 1-12 and 19-30).
// Layer 2: 6 generators in the central column (regions 13-18).
// The empty positions of the other type are the sensor positions (analysed later in Python).
// Generators are perpendicular nanomagnets. Coordinates are written out explicitly.

SetGridSize(128, 128, 15)
SetCellSize(3e-9, 3e-9, 3e-9)     // box 384 x 384 x 45 nm, origin at the box centre

// CoFeB/Co-like perpendicular magnet (illustrative values, change to your material)
Msat  = 1.0e6
Aex   = 15e-12
Ku1   = 1.0e6
AnisU = vector(0, 0, 1)
alpha = 0.5

// dot diameter 30 nm, thickness 3 nm (one cell in z)
d1 := Cylinder(30e-9, 3e-9).Transl(1.2500e-07, 4.3301e-08, -2.1000e-08)
d2 := Cylinder(30e-9, 3e-9).Transl(1.0000e-07, 8.6603e-08, -2.1000e-08)
d3 := Cylinder(30e-9, 3e-9).Transl(2.5000e-08, 1.2990e-07, -2.1000e-08)
d4 := Cylinder(30e-9, 3e-9).Transl(-2.5000e-08, 1.2990e-07, -2.1000e-08)
d5 := Cylinder(30e-9, 3e-9).Transl(-1.0000e-07, 8.6603e-08, -2.1000e-08)
d6 := Cylinder(30e-9, 3e-9).Transl(-1.2500e-07, 4.3301e-08, -2.1000e-08)
d7 := Cylinder(30e-9, 3e-9).Transl(-1.2500e-07, -4.3301e-08, -2.1000e-08)
d8 := Cylinder(30e-9, 3e-9).Transl(-1.0000e-07, -8.6603e-08, -2.1000e-08)
d9 := Cylinder(30e-9, 3e-9).Transl(-2.5000e-08, -1.2990e-07, -2.1000e-08)
d10 := Cylinder(30e-9, 3e-9).Transl(2.5000e-08, -1.2990e-07, -2.1000e-08)
d11 := Cylinder(30e-9, 3e-9).Transl(1.0000e-07, -8.6603e-08, -2.1000e-08)
d12 := Cylinder(30e-9, 3e-9).Transl(1.2500e-07, -4.3301e-08, -2.1000e-08)
d13 := Cylinder(30e-9, 3e-9).Transl(3.3750e-08, 1.9486e-08, 0.0000e+00)
d14 := Cylinder(30e-9, 3e-9).Transl(7.4940e-24, 3.8971e-08, 0.0000e+00)
d15 := Cylinder(30e-9, 3e-9).Transl(-3.3750e-08, 1.9486e-08, 0.0000e+00)
d16 := Cylinder(30e-9, 3e-9).Transl(-3.3750e-08, -1.9486e-08, 0.0000e+00)
d17 := Cylinder(30e-9, 3e-9).Transl(-7.4940e-24, -3.8971e-08, 0.0000e+00)
d18 := Cylinder(30e-9, 3e-9).Transl(3.3750e-08, -1.9486e-08, 0.0000e+00)
d19 := Cylinder(30e-9, 3e-9).Transl(1.2500e-07, 4.3301e-08, 2.1000e-08)
d20 := Cylinder(30e-9, 3e-9).Transl(1.0000e-07, 8.6603e-08, 2.1000e-08)
d21 := Cylinder(30e-9, 3e-9).Transl(2.5000e-08, 1.2990e-07, 2.1000e-08)
d22 := Cylinder(30e-9, 3e-9).Transl(-2.5000e-08, 1.2990e-07, 2.1000e-08)
d23 := Cylinder(30e-9, 3e-9).Transl(-1.0000e-07, 8.6603e-08, 2.1000e-08)
d24 := Cylinder(30e-9, 3e-9).Transl(-1.2500e-07, 4.3301e-08, 2.1000e-08)
d25 := Cylinder(30e-9, 3e-9).Transl(-1.2500e-07, -4.3301e-08, 2.1000e-08)
d26 := Cylinder(30e-9, 3e-9).Transl(-1.0000e-07, -8.6603e-08, 2.1000e-08)
d27 := Cylinder(30e-9, 3e-9).Transl(-2.5000e-08, -1.2990e-07, 2.1000e-08)
d28 := Cylinder(30e-9, 3e-9).Transl(2.5000e-08, -1.2990e-07, 2.1000e-08)
d29 := Cylinder(30e-9, 3e-9).Transl(1.0000e-07, -8.6603e-08, 2.1000e-08)
d30 := Cylinder(30e-9, 3e-9).Transl(1.2500e-07, -4.3301e-08, 2.1000e-08)
DefRegion(1, d1)
DefRegion(2, d2)
DefRegion(3, d3)
DefRegion(4, d4)
DefRegion(5, d5)
DefRegion(6, d6)
DefRegion(7, d7)
DefRegion(8, d8)
DefRegion(9, d9)
DefRegion(10, d10)
DefRegion(11, d11)
DefRegion(12, d12)
DefRegion(13, d13)
DefRegion(14, d14)
DefRegion(15, d15)
DefRegion(16, d16)
DefRegion(17, d17)
DefRegion(18, d18)
DefRegion(19, d19)
DefRegion(20, d20)
DefRegion(21, d21)
DefRegion(22, d22)
DefRegion(23, d23)
DefRegion(24, d24)
DefRegion(25, d25)
DefRegion(26, d26)
DefRegion(27, d27)
DefRegion(28, d28)
DefRegion(29, d29)
DefRegion(30, d30)
shp := d1
shp = shp.Add(d2)
shp = shp.Add(d3)
shp = shp.Add(d4)
shp = shp.Add(d5)
shp = shp.Add(d6)
shp = shp.Add(d7)
shp = shp.Add(d8)
shp = shp.Add(d9)
shp = shp.Add(d10)
shp = shp.Add(d11)
shp = shp.Add(d12)
shp = shp.Add(d13)
shp = shp.Add(d14)
shp = shp.Add(d15)
shp = shp.Add(d16)
shp = shp.Add(d17)
shp = shp.Add(d18)
shp = shp.Add(d19)
shp = shp.Add(d20)
shp = shp.Add(d21)
shp = shp.Add(d22)
shp = shp.Add(d23)
shp = shp.Add(d24)
shp = shp.Add(d25)
shp = shp.Add(d26)
shp = shp.Add(d27)
shp = shp.Add(d28)
shp = shp.Add(d29)
shp = shp.Add(d30)
print("1/4 shapes defined")
SetGeom(shp)
print("2/4 geometry set")

m = Uniform(0, 0, 1)
print("3/4 starting first relax (the demag kernel is computed here on the first run)")
Relax()
print("4/4 first relax done")
print("baseline: all generators up")
Save(B_demag)        // b_demag000000.ovf = baseline

// flip each generator alone: files b_demag000001 ... b_demag000030
for g := 1; g <= 30; g++ {
    m.SetRegion(g, Uniform(0, 0, -1))
    Relax()
    print("generator", g, "flipped, mz after relax:", m.Region(g).Average())
    Save(B_demag)
    m.SetRegion(g, Uniform(0, 0, 1))
    Relax()
}
// Check the log: every flipped generator should still show mz close to -1.
// If one shows +1, the neighbours' field flipped it back: the cell is not stable at these sizes.
